{
  "manifest_version": 3,
  "name": "Referee",
  "version": "1.0.1",
  "description": "Checks your writing against the sources you have read, in Word, Overleaf, Google Docs and Notion.",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Referee",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "skip.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "overleaf/page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "vendor/katex/katex.min.js",
        "vendor/katex/typeset.js",
        "overleaf/latex.js",
        "overleaf/checker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/document/d/*",
        "https://www.notion.so/*",
        "https://*.notion.site/*"
      ],
      "js": [
        "docs/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*"
      ],
      "matches": [
        "https://www.overleaf.com/*"
      ]
    }
  ]
}
